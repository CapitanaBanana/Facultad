Vagrant.configure("2") do |config|
  # Base box, a simple/reduced one, ubuntu 22
  config.vm.box = "ubuntu/jammy64"

  # Set memory size
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "512"
    vb.name = "Ubuntu22b"
  end

  # Set hostname
  config.vm.hostname = "Ubuntu22b"

  # Public/bridged network
  config.vm.network "public_network"

  config.vm.provision "shell", inline: <<-SHELL
    # Get updated urls/packages sources? & tools
    apt-get update
    apt-get install -y net-tools joe zip build-essential

    # The alias for ls
    grep -q "alias ls='ls -la'" /home/vagrant/.bashrc || echo -e "\\nalias ls='ls -la'" >> /home/vagrant/.bashrc
  SHELL
end
