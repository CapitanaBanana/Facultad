Vagrant.configure("2") do |config|

  ("a".."b").each do |id|
    config.vm.define "vm#{id}" do |machine|
      machine.vm.box = "ubuntu/jammy64"
      machine.vm.network "public_network"
      machine.vm.hostname = "vm#{id}"

      machine.vm.provider "virtualbox" do |vb|
        vb.memory = "512"
        vb.name = "vm#{id}"
      end
    
      machine.vm.provision "shell", inline: <<-SHELL
        # Get updated urls/packages sources & tools
        apt-get update

        # Get several software packages
        apt-get install -y net-tools joe zip build-essential

        # The alias for ls
        grep -q "alias ls='ls -la'" /home/vagrant/.bashrc || echo -e "\\nalias ls='ls -la'" >> /home/vagrant/.bashrc
      SHELL
    end
  end
end
